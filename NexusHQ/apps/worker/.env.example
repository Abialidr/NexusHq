# Optional fallback: the admin's setup wizard (/setup) writes nexushq.config.json at the repo root, which takes
# precedence over this file. Only needed if you skip the wizard.
# Only what the worker needs to reach Supabase. Provider API keys are NOT set here: enter them in the admin
# (Upwork cockpit → AI agents → API keys); the worker fetches them from Supabase Vault.
# Supabase project (publishable key only). The worker signs in as its own user with app_metadata.role = 'worker'.
SUPABASE_URL=https://wcnqstqxvyualbneeopm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
WORKER_EMAIL=worker@example.com
# The password is a secret: store it with `npm run worker -- keys set worker_password` instead of here.
# WORKER_PASSWORD=
# Shown in the admin
WORKER_NAME=laptop
