# Optional fallback: the setup wizard (/setup) writes nexushq.config.json at the repo root, which takes precedence
# and is read at runtime. These build-time values are only used when that file doesn't exist.
# Supabase project (publishable key only; the app stores no service-role/secret key — the wizard uses one once)
NEXT_PUBLIC_SUPABASE_URL=https://wcnqstqxvyualbneeopm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: shows a "View site" link in the top bar
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000
